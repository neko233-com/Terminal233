{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neko233-com/nekossh/blob/main/release-manifest.schema.json",
  "title": "NekoSSH Windows release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "version",
    "tag",
    "commit",
    "shortCommit",
    "source",
    "prerelease",
    "publishable",
    "generatedAtUtc",
    "toolchain",
    "signing",
    "assets",
    "webRuntime",
    "windowsInstaller",
    "checksumFile",
    "releaseNotesFile",
    "signatures"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "repository": {
      "const": "neko233-com/nekossh"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "shortCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commit",
        "tree",
        "snapshotSha256",
        "digestFormat",
        "trackedFileCount"
      ],
      "properties": {
        "branch": { "const": "main" },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "snapshotSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "digestFormat": { "const": "git-raw-blobs-sha256-v1" },
        "trackedFileCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "prerelease": {
      "type": "boolean"
    },
    "publishable": {
      "type": "boolean"
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$"
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policySha256", "platform", "target", "tools"],
      "properties": {
        "policySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "platform": { "const": "windows-x64" },
        "target": { "const": "x86_64-pc-windows-msvc" },
        "tools": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "length", "sha256", "version", "signature"],
            "properties": {
              "name": {
                "enum": [
                  "powershell",
                  "git",
                  "gh",
                  "node",
                  "npm",
                  "rustc",
                  "cargo",
                  "cargoAudit",
                  "perl",
                  "nasm",
                  "vswhere",
                  "signtool"
                ]
              },
              "length": { "type": "integer", "minimum": 1 },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\r\\n]+$"
              },
              "signature": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["status", "subject", "thumbprint", "spkiSha256", "timestamped"],
                    "properties": {
                      "status": { "const": "NotSigned" },
                      "subject": { "type": "null" },
                      "thumbprint": { "type": "null" },
                      "spkiSha256": { "type": "null" },
                      "timestamped": { "const": false }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["status", "subject", "thumbprint", "spkiSha256", "timestamped"],
                    "properties": {
                      "status": { "const": "Valid" },
                      "subject": { "type": "string", "minLength": 1, "maxLength": 2048 },
                      "thumbprint": {
                        "type": "string",
                        "pattern": "^[0-9A-F]{40}$"
                      },
                      "spkiSha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "timestamped": { "type": "boolean" }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "expectedSignerThumbprint",
        "expectedSignerSubject",
        "expectedSignerSpkiSha256",
        "policySha256",
        "timestampRequired"
      ],
      "properties": {
        "mode": {
          "enum": ["authenticode", "unsigned-test"]
        },
        "expectedSignerThumbprint": {
          "type": ["string", "null"],
          "pattern": "^[0-9A-F]{40}$"
        },
        "expectedSignerSubject": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "expectedSignerSpkiSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "policySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "timestampRequired": {
          "type": "boolean"
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/assetRecord"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "tauri-msi" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "tauri-nsis" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "web-portable" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "third-party-notices" } }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "webRuntime": {
      "$ref": "#/$defs/webRuntime"
    },
    "windowsInstaller": {
      "$ref": "#/$defs/windowsInstaller"
    },
    "checksumFile": {
      "$ref": "#/$defs/fileRecord",
      "type": "object",
      "properties": {
        "name": { "const": "SHA256SUMS.txt" }
      }
    },
    "releaseNotesFile": {
      "$ref": "#/$defs/fileRecord",
      "type": "object",
      "properties": {
        "name": { "const": "RELEASE_NOTES.md" }
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/signatureRecord"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "signing": {
            "type": "object",
            "properties": { "mode": { "const": "unsigned-test" } }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "publishable": { "const": false },
          "signing": {
            "type": "object",
            "properties": {
              "expectedSignerThumbprint": { "type": "null" },
              "expectedSignerSubject": { "type": "null" },
              "expectedSignerSpkiSha256": { "type": "null" },
              "timestampRequired": { "const": false }
            }
          },
          "webRuntime": {
            "type": "object",
            "properties": {
              "selfTest": { "const": "skipped-unsigned" },
              "launcher": {
                "type": "object",
                "properties": {
                  "status": { "const": "NotSigned" },
                  "signerThumbprint": { "type": "null" },
                  "signerSubject": { "type": "null" },
                  "signerSpkiSha256": { "type": "null" },
                  "timestamped": { "const": false }
                }
              }
            }
          },
          "signatures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Status": { "const": "NotSigned" },
                "SignerThumbprint": { "type": "null" },
                "SignerSubject": { "type": "null" },
                "SignerSpkiSha256": { "type": "null" },
                "Timestamped": { "const": false }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "signing": {
            "type": "object",
            "properties": { "mode": { "const": "authenticode" } }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "signing": {
            "type": "object",
            "properties": {
              "expectedSignerThumbprint": { "type": "string" },
              "expectedSignerSubject": { "type": "string" },
              "expectedSignerSpkiSha256": { "type": "string" },
              "timestampRequired": { "const": true }
            }
          },
          "webRuntime": {
            "type": "object",
            "properties": {
              "selfTest": { "const": "passed" },
              "launcher": {
                "type": "object",
                "properties": {
                  "status": { "const": "Valid" },
                  "signerThumbprint": { "type": "string" },
                  "signerSubject": { "type": "string" },
                  "signerSpkiSha256": { "type": "string" },
                  "timestamped": { "const": true }
                }
              }
            }
          },
          "signatures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Status": { "const": "Valid" },
                "SignerThumbprint": { "type": "string" },
                "SignerSubject": { "type": "string" },
                "SignerSpkiSha256": { "type": "string" },
                "Timestamped": { "const": true }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "signing": {
                "type": "object",
                "properties": { "mode": { "const": "authenticode" } }
              }
            }
          },
          {
            "type": "object",
            "properties": { "prerelease": { "const": false } }
          }
        ]
      },
      "then": {
        "type": "object",
        "properties": { "publishable": { "const": true } }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "prerelease": { "const": true } }
      },
      "then": {
        "type": "object",
        "properties": { "publishable": { "const": false } }
      }
    }
  ],
  "$defs": {
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\:]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "assetRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "bytes", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\:]+$"
        },
        "kind": {
          "enum": ["tauri-msi", "tauri-nsis", "web-portable", "third-party-notices"]
        },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "signatureRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Name",
        "Status",
        "SignerThumbprint",
        "SignerSubject",
        "SignerSpkiSha256",
        "Timestamped"
      ],
      "properties": {
        "Name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\:]+$"
        },
        "Status": { "enum": ["Valid", "NotSigned"] },
        "SignerThumbprint": {
          "type": ["string", "null"],
          "pattern": "^[0-9A-F]{40}$"
        },
        "SignerSubject": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "SignerSpkiSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "Timestamped": { "type": "boolean" }
      }
    },
    "windowsInstaller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productCode",
        "productName",
        "manufacturer",
        "productLanguage",
        "productVersion",
        "upgradeCode"
      ],
      "properties": {
        "productCode": {
          "type": "string",
          "pattern": "^\\{[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}\\}$"
        },
        "productName": { "const": "NekoSSH" },
        "manufacturer": { "const": "NekoSSH contributors" },
        "productLanguage": { "const": "2052" },
        "productVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[A-Za-z-][0-9A-Za-z-]*))*)?$"
        },
        "upgradeCode": { "const": "{44F1588E-BCFD-5973-A955-237DAF92726D}" }
      }
    },
    "webRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archiveSha256", "version", "launcher", "node", "selfTest"],
      "properties": {
        "archiveSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[A-Za-z-][0-9A-Za-z-]*))*)?$"
        },
        "launcher": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "signerThumbprint",
            "signerSubject",
            "signerSpkiSha256",
            "timestamped"
          ],
          "properties": {
            "status": { "enum": ["Valid", "NotSigned"] },
            "signerThumbprint": {
              "type": ["string", "null"],
              "pattern": "^[0-9A-F]{40}$"
            },
            "signerSubject": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "signerSpkiSha256": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-f]{64}$"
            },
            "timestamped": { "type": "boolean" }
          }
        },
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "sha256", "status", "signerSubject", "timestamped"],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "status": { "const": "Valid" },
            "signerSubject": { "type": "string", "minLength": 1 },
            "timestamped": { "const": true }
          }
        },
        "selfTest": {
          "enum": ["passed", "skipped-unsigned"]
        }
      }
    }
  }
}
