{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neko233-com/nekossh/blob/main/release-toolchain-lock.schema.json",
  "title": "NekoSSH external Windows release builder toolchain lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "platform", "tools"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "platform": { "const": "windows-x64" },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "powershell",
        "git",
        "gh",
        "node",
        "npm",
        "rustc",
        "cargo",
        "cargoAudit",
        "vswhere",
        "signtool"
      ],
      "properties": {
        "powershell": { "$ref": "#/$defs/tool" },
        "git": { "$ref": "#/$defs/tool" },
        "gh": { "$ref": "#/$defs/tool" },
        "node": { "$ref": "#/$defs/tool" },
        "npm": { "$ref": "#/$defs/tool" },
        "rustc": { "$ref": "#/$defs/tool" },
        "cargo": { "$ref": "#/$defs/tool" },
        "cargoAudit": { "$ref": "#/$defs/tool" },
        "vswhere": { "$ref": "#/$defs/tool" },
        "signtool": { "$ref": "#/$defs/tool" }
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "length", "sha256", "version", "signature"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z]:\\\\"
        },
        "length": { "type": "integer", "minimum": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\r\\n]+$"
        },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "signature": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "subject", "thumbprint", "spkiSha256", "timestamped"],
          "properties": {
            "status": { "const": "NotSigned" },
            "subject": { "type": "null" },
            "thumbprint": { "type": "null" },
            "spkiSha256": { "type": "null" },
            "timestamped": { "const": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "subject", "thumbprint", "spkiSha256", "timestamped"],
          "properties": {
            "status": { "const": "Valid" },
            "subject": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "thumbprint": {
              "type": "string",
              "pattern": "^[0-9A-F]{40}$"
            },
            "spkiSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "timestamped": { "type": "boolean" }
          }
        }
      ]
    }
  }
}
